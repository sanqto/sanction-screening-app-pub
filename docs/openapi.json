    "/v1/screen/person": {
      "post": {
        "security": [{"apiKey": []}],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": ["first_name", "last_name"],
                "properties": {
                  "first_name": {"type": "string"},
                  "last_name": {"type": "string"},
                  "dob": {"type": "string", "description": "Optional; YYYY or YYYY-MM-DD. Missing DOB returns POSSIBLE on name-only match when the listed entity has DOB."},
                  "citizenship": {"type": "string"},
                  "external_ref": {"type": "string"}
                }
              },
              "example": {
                "first_name": "Ali",
                "last_name": "Darassa",
                "dob": "1978-09-22",
                "citizenship": "",
                "external_ref": "demo-match-001"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "MATCH, POSSIBLE, or CLEAR decision with pinned list_versions and the full set of matched_sources (one row per sanctions list the subject is on). Each list_versions source includes updated_at, fetched_at, source_version, and content_sha256 for audit evidence.",
            "content": {
              "application/json": {
                "example": {
                  "decision": "MATCH",
                  "request_id": "ea5b2339-dff9-43e0-af99-c6f84ac9471f",
                  "matched_sources": [
                    {"source": "EU_FSF", "entity_id": 8053, "dob_precision": "date"},
                    {"source": "US_OFAC", "entity_id": 12174, "dob_precision": "date"},
                    {"source": "UK_FCDO", "entity_id": 6909, "dob_precision": "date"}
                  ],
                  "list_versions": {
                    "eu": {
                      "updated_at": "Fri, 08 May 2026 14:10:10 GMT",
                      "fetched_at": "2026-05-11T08:51:14.910876+00:00",
                      "source_version": "1252222B875D684D0C853F9B313301F6C14AAFB5",
                      "content_sha256": "d8c16cf7e12b29d57979b264efe5c11e48bc791ea8609e9116942dc79bfa2619",
                      "archive_path": "/Users/alex/.local/share/sanction-screening/list-archive/EU_FSF/20260511T085114Z-d8c16cf7e12b29d5.xml"
                    },
                    "un": {
                      "updated_at": "2026-05-09T23:00:02.101Z",
                      "fetched_at": "2026-05-11T08:51:17.176560+00:00",
                      "source_version": "2026-05-09T23:00:02.101Z",
                      "content_sha256": "51e414dd23e84cf63917374197c3a74c353cb578bb55e3a6469d87bfc06e286c",
                      "archive_path": "/Users/alex/.local/share/sanction-screening/list-archive/UN_SC/20260511T085117Z-51e414dd23e84cf6.xml"
                    },
                    "pl": {
                      "updated_at": "2026-05-11T18:36:19.243635+00:00",
                      "fetched_at": "2026-05-11T18:40:10.100000+00:00",
                      "source_version": "809509c95e81e0d56eaad165368792f287cf560490d025aae685147375815461",
                      "content_sha256": "e692cff58a7bab08eca1bf90edacae6eadee2a353e4a6125c02f8cb5a31af5d0",
                      "archive_path": "/Users/alex/.local/share/sanction-screening/list-archive/PL_MSWIA/20260511T184010Z-e692cff58a7bab08.xml"
                    },
                    "us": {
