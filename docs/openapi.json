{
  "openapi": "3.0.3",
  "info": {
    "title": "Sanction Screening API",
    "version": "0.1.7"
  },
  "paths": {
    "/healthz": {
      "get": {
        "responses": {
          "200": {
            "description": "Process is alive"
          }
        }
      }
    },
    "/readyz": {
      "get": {
        "responses": {
          "200": {
            "description": "All enabled sanctions sources are loaded and fresh",
            "content": {
              "application/json": {
                "example": {
                  "status": "ready",
                  "entity_count": 5124,
                  "entity_counts": {
                    "eu": 4392,
                    "un": 732
                  },
                  "list_versions": {
                    "eu": {
                      "updated_at": "Fri, 08 May 2026 14:10:10 GMT",
                      "fetched_at": "2026-05-11T14:33:29.550004+00:00",
                      "source_version": "1252222B875D684D0C853F9B313301F6C14AAFB5",
                      "content_sha256": "d8c16cf7e12b29d57979b264efe5c11e48bc791ea8609e9116942dc79bfa2619",
                      "archive_path": "/Users/alex/.local/share/sanction-screening/list-archive/EU_FSF/20260511T143329Z-d8c16cf7e12b29d5.xml"
                    },
                    "un": {
                      "updated_at": "2026-05-09T23:00:02.101Z",
                      "fetched_at": "2026-05-11T14:33:31.896727+00:00",
                      "source_version": "2026-05-09T23:00:02.101Z",
                      "content_sha256": "51e414dd23e84cf63917374197c3a74c353cb578bb55e3a6469d87bfc06e286c",
                      "archive_path": "/Users/alex/.local/share/sanction-screening/list-archive/UN_SC/20260511T143331Z-51e414dd23e84cf6.xml"
                    }
                  }
                }
              }
            }
          },
          "503": {
            "description": "Not ready"
          }
        }
      }
    },
    "/v1/screen/person": {
      "post": {
        "security": [{"apiKey": []}],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": ["first_name", "last_name"],
                "properties": {
                  "first_name": {"type": "string"},
                  "last_name": {"type": "string"},
                  "dob": {"type": "string", "description": "Optional; YYYY or YYYY-MM-DD. Missing DOB returns POSSIBLE on name-only match when the listed entity has DOB."},
                  "citizenship": {"type": "string"},
                  "external_ref": {"type": "string"}
                }
              },
              "example": {
                "first_name": "Ali",
                "last_name": "Darassa",
                "dob": "1978-09-22",
                "citizenship": "",
                "external_ref": "demo-match-001"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "MATCH, POSSIBLE, or CLEAR decision with pinned list_versions. Each source includes updated_at, fetched_at, source_version, and content_sha256 for audit evidence.",
            "content": {
              "application/json": {
                "example": {
                  "decision": "MATCH",
                  "request_id": "ea5b2339-dff9-43e0-af99-c6f84ac9471f",
                  "matched_source": "EU_FSF",
                  "matched_entity_id": 8053,
                  "dob_precision": "date",
                  "list_versions": {
                    "eu": {
                      "updated_at": "Fri, 08 May 2026 14:10:10 GMT",
                      "fetched_at": "2026-05-11T08:51:14.910876+00:00",
                      "source_version": "1252222B875D684D0C853F9B313301F6C14AAFB5",
                      "content_sha256": "d8c16cf7e12b29d57979b264efe5c11e48bc791ea8609e9116942dc79bfa2619",
                      "archive_path": "/Users/alex/.local/share/sanction-screening/list-archive/EU_FSF/20260511T085114Z-d8c16cf7e12b29d5.xml"
                    },
                    "un": {
                      "updated_at": "2026-05-09T23:00:02.101Z",
                      "fetched_at": "2026-05-11T08:51:17.176560+00:00",
                      "source_version": "2026-05-09T23:00:02.101Z",
                      "content_sha256": "51e414dd23e84cf63917374197c3a74c353cb578bb55e3a6469d87bfc06e286c",
                      "archive_path": "/Users/alex/.local/share/sanction-screening/list-archive/UN_SC/20260511T085117Z-51e414dd23e84cf6.xml"
                    }
                  },
                  "algorithm_version": "person-dob-strict-v1"
                }
              }
            }
          },
          "401": {"description": "Unauthorized"},
          "422": {"description": "Invalid screening input"}
        }
      }
    },
    "/v1/lists/status": {
      "get": {
        "security": [{"apiKey": []}],
        "responses": {
          "200": {"description": "EU FSF source metadata"}
        }
      }
    },
    "/v1/audit": {
      "get": {
        "security": [{"apiKey": []}],
        "parameters": [{"name": "limit", "in": "query", "schema": {"type": "integer", "default": 20, "minimum": 1, "maximum": 100}}],
        "responses": {
          "200": {"description": "Append-only screening audit rows"}
        }
      }
    },
    "/v1/admin/refresh": {
      "post": {
        "security": [{"apiKey": []}],
        "responses": {
          "200": {"description": "Refresh completed"},
          "502": {"description": "Refresh failed"}
        }
      }
    }
  },
  "components": {
    "securitySchemes": {
      "apiKey": {
        "type": "apiKey",
        "in": "header",
        "name": "X-API-Key"
      }
    }
  }
}
