    "/v1/screen/organization": {
      "post": {
        "security": [{"apiKey": []}],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": ["name"],
                "properties": {
                  "name": {"type": "string"},
                  "identifiers": {
                    "type": "array",
                    "description": "Optional registry identifiers. Exact identifier match returns MATCH even when the supplied name differs.",
                    "items": {
                      "type": "object",
                      "required": ["kind", "value"],
                      "properties": {
                        "kind": {"type": "string", "example": "NIP"},
                        "value": {"type": "string", "example": "9511861015"}
                      }
                    }
                  },
                  "country": {"type": "string"},
                  "external_ref": {"type": "string"}
                }
              },
              "example": {
                "name": "GO SPORT POLSKA",
                "identifiers": [{"kind": "NIP", "value": "9511861015"}],
                "country": "PL",
                "external_ref": "demo-org-match-001"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "MATCH on exact registry identifier or exact normalized name, POSSIBLE on similar canonical name, otherwise CLEAR. v0.2 loads organizations from EU FSF, UN SC, UK FCDO, and PL MSWiA.",
            "content": {
              "application/json": {
                "example": {
                  "decision": "MATCH",
                  "request_id": "8fe6fe31-6873-463c-992f-071382d2c263",
                  "matched_organizations": [
                    {
                      "source": "PL_MSWIA",
                      "organization_id": 42,
                      "match_type": "identifier",
                      "matched_name": "GO SPORT POLSKA Sp. z o.o.",
                      "matched_identifier": {"kind": "NIP", "value": "9511861015"}
                    }
                  ],
                  "list_versions": {},
                  "algorithm_version": "organization-name-id-v1"
                }
              }
            }
          },
          "401": {"description": "Unauthorized"},
          "422": {"description": "Invalid screening input"}
        }
      }
    },
    "/v1/lists/status": {
      "get": {
        "security": [{"apiKey": []}],
        "responses": {
          "200": {"description": "Source metadata for enabled EU FSF, UN SC, PL MSWiA, US OFAC SDN, and UK FCDO lists"}
        }
      }
    },
    "/v1/audit": {
      "get": {
        "security": [{"apiKey": []}],
        "parameters": [{"name": "limit", "in": "query", "schema": {"type": "integer", "default": 20, "minimum": 1, "maximum": 100}}],
        "responses": {
          "200": {"description": "Append-only screening audit rows"}
        }
      }
    },
    "/v1/audit/organizations": {
      "get": {
        "security": [{"apiKey": []}],
        "parameters": [{"name": "limit", "in": "query", "schema": {"type": "integer", "default": 20, "minimum": 1, "maximum": 100}}],
        "responses": {
          "200": {"description": "Append-only organization screening audit rows"}
        }
      }
    },
    "/v1/admin/refresh": {
      "post": {
        "security": [{"apiKey": []}],
        "responses": {
          "200": {"description": "Refresh completed"},
          "502": {"description": "Refresh failed"}
        }
      }
    }
  },
  "components": {
    "securitySchemes": {
      "apiKey": {
        "type": "apiKey",
        "in": "header",
        "name": "X-API-Key"
      }
    }
  }
