{
  "openapi": "3.0.3",
  "info": {
    "title": "Sanction Screening API",
    "version": "0.1.0"
  },
  "paths": {
    "/healthz": {
      "get": {
        "responses": {
          "200": {
            "description": "Process is alive"
          }
        }
      }
    },
    "/readyz": {
      "get": {
        "responses": {
          "200": {
            "description": "EU FSF list loaded and fresh"
          },
          "503": {
            "description": "Not ready"
          }
        }
      }
    },
    "/v1/screen/person": {
      "post": {
        "security": [{"apiKey": []}],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": ["first_name", "last_name"],
                "properties": {
                  "first_name": {"type": "string"},
                  "last_name": {"type": "string"},
                  "dob": {"type": "string", "description": "Optional; YYYY or YYYY-MM-DD. Missing DOB returns POSSIBLE on name-only match when the listed entity has DOB."},
                  "citizenship": {"type": "string"},
                  "external_ref": {"type": "string"}
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "MATCH, POSSIBLE, or CLEAR decision with pinned list_versions for audit evidence"
          },
          "401": {"description": "Unauthorized"},
          "422": {"description": "Invalid screening input"}
        }
      }
    },
    "/v1/lists/status": {
      "get": {
        "security": [{"apiKey": []}],
        "responses": {
          "200": {"description": "EU FSF source metadata"}
        }
      }
    },
    "/v1/audit": {
      "get": {
        "security": [{"apiKey": []}],
        "parameters": [{"name": "limit", "in": "query", "schema": {"type": "integer", "default": 20, "minimum": 1, "maximum": 100}}],
        "responses": {
          "200": {"description": "Append-only screening audit rows"}
        }
      }
    },
    "/v1/admin/refresh": {
      "post": {
        "security": [{"apiKey": []}],
        "responses": {
          "200": {"description": "Refresh completed"},
          "502": {"description": "Refresh failed"}
        }
      }
    }
  },
  "components": {
    "securitySchemes": {
      "apiKey": {
        "type": "apiKey",
        "in": "header",
        "name": "X-API-Key"
      }
    }
  }
}
